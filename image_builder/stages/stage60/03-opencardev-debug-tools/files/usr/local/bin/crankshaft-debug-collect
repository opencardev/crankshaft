#!/usr/bin/env python3
"""Compatibility wrapper for the modular collector project.

The real implementation lives in /usr/share/crankshaft/debug-collector.
Keeping this tiny wrapper preserves existing operator workflows that invoke
`crankshaft-debug-collect` from PATH.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

PROJECT_ROOT = Path("/usr/share/crankshaft/debug-collector")
SRC_ROOT = PROJECT_ROOT / "src"

if str(SRC_ROOT) not in sys.path:
    sys.path.insert(0, str(SRC_ROOT))


def load_main():
    """Import entrypoint lazily after dynamic sys.path setup."""
    module = importlib.import_module("crankshaft_debug_collector.cli")
    return module.main


if __name__ == "__main__":
    load_main()()
