#!/usr/bin/env python3
"""Fallback entry point – should not be reached on a correctly built image.

The canonical entry point is installed by:
    uv pip install --system /usr/share/crankshaft/debug-collector

That command writes the real entry point (from pyproject.toml [project.scripts])
directly into /usr/local/bin. This file is only present as a safety fallback in
case uv was not available during the image build; it loads the project source from
the staged location via sys.path injection.
"""

from __future__ import annotations

import importlib
import sys
from pathlib import Path

# Staged project source location – matches the path used by 00-run.sh.
PROJECT_SRC = Path("/usr/share/crankshaft/debug-collector/src")

if str(PROJECT_SRC) not in sys.path:
    sys.path.insert(0, str(PROJECT_SRC))


def load_main():
    """Import the CLI entrypoint lazily after dynamic sys.path setup."""
    module = importlib.import_module("crankshaft_debug_collector.cli")
    return module.main


if __name__ == "__main__":
    load_main()()
